<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!--
        rental_set.PickingFoldField  —  RS-42 / RS-47
        ────────────────────────────────────────────
        Set hierarchy gutter for the stock.move lines on the picking form.
        Mirrors rental_set.FoldField: one caret, only on a row that has
        components, no box-drawing characters.  Purely cosmetic — the grouping
        key, the "[Set] " prefix and the zero-demand header move keep the
        semantics fixed by docs/rental_scanning_requirements.md.
    -->
    <t t-name="rental_set.PickingFoldField">
        <button t-if="this.hasChildren"
                type="button"
                class="btn o_rental_set_fold border-0 p-0"
                t-att-title="this.toggleTitle"
                t-on-click.stop.prevent="this.onToggle">
            <i class="oi oi-fw"
               t-attf-data-icon="{{ this.isFolded ? 'arrow_right' : 'arrow_drop_down' }}"/>
        </button>
    </t>
</templates>
