<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Same glyph as the standard product-level availability widget
         (sale_stock QtyAtDate uses data-icon="area_chart"); red when short. -->
    <t t-name="rental_set.RentalSetQtyWidget">
        <a t-if="this.calcData().show"
           t-on-click="this.showPopup"
           tabindex="0"
           t-attf-class="oi cursor-pointer {{ this.calcData().sufficient ? '' : 'text-danger' }}"
           data-icon="area_chart"
           title="Set Availability"
        />
    </t>

    <!-- Popover with set availability overview (no component links, kept simple) -->
    <t t-name="rental_set.RentalSetAvailPopover">
        <div class="p-2" style="min-width: 200px;">
            <h6>Set Availability</h6>
            <table class="table table-borderless table-sm mb-1">
                <tbody>
                    <tr>
                        <td>Requested</td>
                        <td class="text-end">
                            <b t-out="this.props.calcData.requested"/>
                            sets
                        </td>
                    </tr>
                    <tr>
                        <td>Available</td>
                        <td class="text-end">
                            <b t-out="Math.floor(this.props.calcData.available)"
                               t-attf-class="{{ this.props.calcData.sufficient ? '' : 'text-danger' }}"/>
                            sets
                        </td>
                    </tr>
                </tbody>
            </table>
            <div t-if="this.props.calcData.sufficient" class="text-muted small">
                <i class="oi" data-icon="check_circle"/> Sufficient stock for this order.
            </div>
            <div t-else="" class="text-danger small">
                <i class="oi" data-icon="warning"/> Not enough stock to fulfil the requested quantity.
            </div>
        </div>
    </t>


</templates>
