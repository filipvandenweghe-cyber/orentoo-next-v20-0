<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!--
        rental_set.FoldField  —  RS-42 / RS-45
        ──────────────────────────────────────
        The set hierarchy gutter.  One disclosure control per row, and only on a
        row that HAS children:

          row with components → caret button (arrow_drop_down open /
                                arrow_right folded), plus a muted count while
                                folded so nothing is hidden without a trace
          every other row     → empty cell

        Depth is NOT drawn here: the product cell is indented per level by
        SaleOrderLineListRenderer.getCellClass (RS-40).  No box-drawing
        characters anywhere (RS-41).
    -->
    <t t-name="rental_set.FoldField">
        <t t-if="this.hasChildren">
            <!--
                A real <button>: Odoo's CSS kills pointer-events on form-check
                elements inside non-selected rows, which a plain <i> would
                inherit.  The .stop.prevent modifiers plus the special_click
                flag in onToggle keep onCellClicked from entering edit mode.
            -->
            <button type="button"
                    class="btn o_rental_set_fold border-0 p-0"
                    t-att-title="this.toggleTitle"
                    t-on-click.stop.prevent="this.onToggle">
                <i class="oi oi-fw"
                   t-attf-data-icon="{{ this.isFolded ? 'arrow_right' : 'arrow_drop_down' }}"/>
            </button>
            <span t-if="this.isFolded"
                  class="o_rental_set_count"
                  t-att-title="this.hiddenTitle"
                  t-out="this.childCount"/>
        </t>
    </t>
</templates>
