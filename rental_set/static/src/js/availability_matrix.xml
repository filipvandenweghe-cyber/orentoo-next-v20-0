<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rental_set.AvailabilityMatrix">
        <div class="o_rental_availability o_action h-100 d-flex flex-column">
            <!-- Toolbar -->
            <div class="o_ra_toolbar p-2 border-bottom">
                <!-- Scope filters: fixed grid, tags wrap INSIDE each cell so
                     neighbours never shift as selections grow. -->
                <div class="o_ra_filters">
                    <div class="o_ra_filter">
                        <label class="small text-muted mb-1">Categories</label>
                        <MultiRecordSelector resModel="'product.category'"
                            resIds="this.state.filters.categoryIds"
                            update="(ids) => this.onFilterUpdate('categoryIds', ids)"
                            placeholder="'Categories…'"/>
                    </div>
                    <div class="o_ra_filter">
                        <label class="small text-muted mb-1">Products</label>
                        <MultiRecordSelector resModel="'product.product'"
                            resIds="this.state.filters.productIds"
                            domain="this.productDomain"
                            update="(ids) => this.onFilterUpdate('productIds', ids)"
                            placeholder="'Search products…'"/>
                    </div>
                    <div class="o_ra_filter">
                        <label class="small text-muted mb-1">Companies</label>
                        <MultiRecordSelector resModel="'res.company'"
                            resIds="this.state.filters.companyIds"
                            update="(ids) => this.onFilterUpdate('companyIds', ids)"
                            placeholder="'Companies…'"/>
                    </div>
                    <div class="o_ra_filter">
                        <label class="small text-muted mb-1">Warehouses</label>
                        <MultiRecordSelector resModel="'stock.warehouse'"
                            resIds="this.state.filters.warehouseIds"
                            domain="this.warehouseDomain"
                            update="(ids) => this.onFilterUpdate('warehouseIds', ids)"
                            placeholder="'Warehouses…'"/>
                    </div>
                    <div class="o_ra_filter">
                        <label class="small text-muted mb-1">Orders</label>
                        <MultiRecordSelector resModel="'sale.order'"
                            resIds="this.state.filters.orderIds"
                            domain="[['is_rental_order', '=', true]]"
                            context="{ 'rental_avail_order_label': 1 }"
                            update="(ids) => this.onFilterUpdate('orderIds', ids)"
                            placeholder="'Order numbers…'"/>
                    </div>
                </div>
                <!-- Compact controls + navigation -->
                <div class="o_ra_controls d-flex flex-wrap align-items-end gap-2 mt-2">
                    <div class="d-flex flex-column">
                        <label class="small text-muted mb-1">Start</label>
                        <input t-if="this.state.filters.interval === 'day'"
                               type="date" class="form-control form-control-sm o_ra_date"
                               t-att-value="this.startDateValue" t-on-change="this.onDateChange"/>
                        <input t-else="" type="datetime-local"
                               class="form-control form-control-sm o_ra_date"
                               t-att-value="this.startDateTimeValue" t-on-change="this.onDateChange"/>
                    </div>
                    <div class="d-flex flex-column">
                        <label class="small text-muted mb-1">Interval</label>
                        <select class="form-select form-select-sm o_ra_ctl" t-on-change="this.onIntervalChange">
                            <option value="30min" t-att-selected="this.state.filters.interval === '30min'">30 minutes</option>
                            <option value="hour" t-att-selected="this.state.filters.interval === 'hour'">1 hour</option>
                            <option value="day" t-att-selected="this.state.filters.interval === 'day'">1 day</option>
                        </select>
                    </div>
                    <div class="d-flex flex-column">
                        <label class="small text-muted mb-1">Display</label>
                        <select class="form-select form-select-sm o_ra_ctl" t-on-change="this.onDisplayChange">
                            <option value="available" t-att-selected="this.state.displayMode === 'available'">Available</option>
                            <option value="ratio" t-att-selected="this.state.displayMode === 'ratio'">Available / Capacity</option>
                            <option value="utilisation" t-att-selected="this.state.displayMode === 'utilisation'">Utilisation %</option>
                        </select>
                    </div>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-secondary" t-on-click="this.onPrev" title="Previous">
                            <i class="oi" data-icon="chevron_backward"/>
                        </button>
                        <button class="btn btn-sm btn-primary" t-on-click="this.onNow">
                            <t t-out="this.state.filters.interval === 'day' ? 'Today' : 'Now'"/>
                        </button>
                        <button class="btn btn-sm btn-secondary" t-on-click="this.onNext" title="Next">
                            <i class="oi" data-icon="chevron_forward"/>
                        </button>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" t-on-click="this.load">
                        <i class="oi me-1" data-icon="refresh"/>Apply
                    </button>
                    <div class="form-check ms-2 mb-1">
                        <input type="checkbox" class="form-check-input"
                               id="o_ra_only_unavailable"
                               t-att-checked="this.state.filters.onlyUnavailable"
                               t-on-change="this.onOnlyUnavailableChange"/>
                        <label class="form-check-label small" for="o_ra_only_unavailable">
                            Only show unavailability
                        </label>
                    </div>
                    <div class="form-check ms-2 mb-1">
                        <input type="checkbox" class="form-check-input"
                               id="o_ra_include_options"
                               t-att-checked="this.state.filters.includeOptions"
                               t-on-change="this.onIncludeOptionsChange"/>
                        <label class="form-check-label small" for="o_ra_include_options">
                            Include options (on option)
                        </label>
                    </div>
                </div>
            </div>

            <!-- Matrix -->
            <div class="o_ra_scroll flex-grow-1 overflow-auto position-relative">
                <t t-if="this.state.loading">
                    <div class="o_ra_loading text-center text-muted p-4">
                        <span class="spinner-border spinner-border-sm me-2" role="status"/>Loading…
                    </div>
                </t>
                <t t-elif="!this.state.data.rows.length">
                    <div class="text-center text-muted p-4">
                        No products in scope. Pick a category or product and click Apply.
                    </div>
                </t>
                <t t-else="">
                    <table class="o_ra_table mb-0">
                        <thead>
                            <tr>
                                <th class="o_ra_sticky o_ra_ident">Product · Company · Warehouse</th>
                                <t t-foreach="this.state.data.columns" t-as="col" t-key="col_index">
                                    <th class="o_ra_col text-center" t-att-title="col.start">
                                        <t t-out="col.label"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="this.state.data.rows" t-as="row" t-key="row.key">
                                <t t-if="this.isNewCategory(row, row_index)">
                                    <tr class="o_ra_group o_ra_group_category">
                                        <th class="o_ra_sticky o_ra_ident o_ra_group_cat"
                                            t-out="row.category"/>
                                        <th class="o_ra_group_fill"
                                            t-att-colspan="this.state.data.columns.length"/>
                                    </tr>
                                </t>
                                <t t-if="this.isNewProduct(row, row_index)">
                                    <tr class="o_ra_group o_ra_group_product">
                                        <th class="o_ra_sticky o_ra_ident o_ra_group_prod text-truncate"
                                            t-out="row.product_name"/>
                                        <th class="o_ra_group_fill"
                                            t-att-colspan="this.state.data.columns.length"/>
                                    </tr>
                                </t>
                                <tr>
                                    <td class="o_ra_sticky o_ra_ident">
                                        <div class="o_ra_whrow text-truncate">
                                            <span t-if="this.showCompany(row, row_index)" class="o_ra_comp">
                                                <t t-out="row.company_name"/> · </span>
                                            <span class="o_ra_wh" t-out="row.warehouse_name"/>
                                        </div>
                                    </td>
                                    <t t-foreach="this.state.data.columns" t-as="col" t-key="col_index">
                                        <td t-attf-class="o_ra_cell text-center {{ this.cellClass(row, col_index) }}"
                                            t-on-click="() => this.onCellClick(row, col_index)">
                                            <t t-out="this.cellText(row, col_index)"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </div>
    </t>

    <t t-name="rental_set.AvailabilityCellDialog">
        <Dialog title="'Availability detail'" size="'lg'">
            <div class="o_ra_detail">
                <table class="table table-sm mb-3">
                    <tbody>
                        <tr><th>Product</th><td t-out="this.props.detail.product_name"/></tr>
                        <tr><th>Company</th><td t-out="this.props.detail.company_name"/></tr>
                        <tr><th>Warehouse</th><td t-out="this.props.detail.warehouse_name"/></tr>
                        <tr><th>Period</th>
                            <td><t t-out="this.props.detail.period.from"/> → <t t-out="this.props.detail.period.to"/></td></tr>
                        <tr><th>Operational Available</th>
                            <td t-out="this.props.detail.available"/></tr>
                        <tr><th>Capacity</th><td t-out="this.props.detail.capacity"/></tr>
                        <tr><th>Utilisation</th>
                            <td><t t-if="this.props.detail.utilisation === null">N/A</t>
                                <t t-else=""><t t-out="this.props.detail.utilisation"/>%</t></td></tr>
                        <tr t-if="this.props.detail.on_option">
                            <th class="text-warning">On option (soft)</th>
                            <td class="text-warning fw-bold" t-out="this.props.detail.on_option"/></tr>
                    </tbody>
                </table>

                <h6>Rental / Sales Orders affecting availability</h6>
                <table class="table table-sm table-striped mb-3" t-if="this.props.detail.orders.length">
                    <thead><tr><th>Order</th><th>Customer</th><th>Start</th><th>End</th><th class="text-end">Qty</th></tr></thead>
                    <tbody>
                        <t t-foreach="this.props.detail.orders" t-as="o" t-key="o_index">
                            <tr>
                                <td>
                                    <a href="#" t-on-click.prevent="() => this.openOrder(o.order_id)"
                                       t-out="o.order_name"/>
                                </td>
                                <td t-out="o.partner"/>
                                <td t-out="o.start"/>
                                <td t-out="o.end"/>
                                <td class="text-end" t-out="o.qty"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p class="text-muted" t-if="!this.props.detail.orders.length">No orders affect this interval.</p>

                <h6 t-if="this.props.detail.option_orders and this.props.detail.option_orders.length"
                    class="text-warning">On option by other orders (soft hold)</h6>
                <table class="table table-sm table-striped mb-3"
                       t-if="this.props.detail.option_orders and this.props.detail.option_orders.length">
                    <thead><tr><th>Order</th><th>Customer</th><th>Start</th><th>End</th><th>Option until</th><th class="text-end">Qty</th></tr></thead>
                    <tbody>
                        <t t-foreach="this.props.detail.option_orders" t-as="o" t-key="o_index">
                            <tr>
                                <td>
                                    <a href="#" t-on-click.prevent="() => this.openOrder(o.order_id)"
                                       t-out="o.order_name"/>
                                </td>
                                <td t-out="o.partner"/>
                                <td t-out="o.start"/>
                                <td t-out="o.end"/>
                                <td t-out="o.until"/>
                                <td class="text-end" t-out="o.qty"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h6>Repairs affecting availability</h6>
                <table class="table table-sm table-striped mb-3" t-if="this.props.detail.repairs.length">
                    <thead><tr><th>Repair</th><th>Status</th><th>Scheduled</th><th class="text-end">Qty</th></tr></thead>
                    <tbody>
                        <t t-foreach="this.props.detail.repairs" t-as="r" t-key="r_index">
                            <tr>
                                <td t-out="r.name"/>
                                <td t-out="r.state"/>
                                <td t-out="r.schedule"/>
                                <td class="text-end" t-out="r.qty"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p class="text-muted" t-if="!this.props.detail.repairs.length">No repairs affect this interval.</p>

                <h6>Availability elsewhere</h6>
                <div class="row">
                    <div class="col-6">
                        <div class="small text-muted mb-1">Same company (internal transfer)</div>
                        <table class="table table-sm" t-if="this.props.detail.elsewhere.same_company.length">
                            <tbody>
                                <t t-foreach="this.props.detail.elsewhere.same_company" t-as="e" t-key="e_index">
                                    <tr><td t-out="e.warehouse_name"/><td class="text-end" t-out="e.available"/></tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="text-muted small" t-if="!this.props.detail.elsewhere.same_company.length">—</p>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted mb-1">Other company (intercompany)</div>
                        <table class="table table-sm" t-if="this.props.detail.elsewhere.other_company.length">
                            <tbody>
                                <t t-foreach="this.props.detail.elsewhere.other_company" t-as="e" t-key="e_index">
                                    <tr>
                                        <td><t t-out="e.company_name"/> / <t t-out="e.warehouse_name"/></td>
                                        <td class="text-end" t-out="e.available"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="text-muted small" t-if="!this.props.detail.elsewhere.other_company.length">—</p>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
