<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_crew" model="ir.ui.view">
        <field name="name">hr.employee.form.crew</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button type="object" name="action_view_crew_availability"
                        class="oe_stat_button" icon="calendar_today"
                        invisible="crew_availability_mode != 'explicit'">
                    <field name="crew_availability_count" widget="statinfo" string="Availability"/>
                </button>
            </div>

            <xpath expr="//page[@name='hr_settings']" position="before">
                <page string="Crew" name="crew">
                    <group>
                        <group string="Crew Planning">
                            <field name="is_crew"/>
                            <field name="crew_availability_mode"/>
                            <field name="crew_saved_calendar_id" invisible="1"/>
                            <field name="user_id" string="Portal / Related User" readonly="1"/>
                        </group>
                        <group>
                            <button type="object" name="action_crew_enter_availability"
                                    string="Enter Availability" class="btn-primary"
                                    invisible="crew_availability_mode != 'explicit'"/>
                            <button type="object" name="action_crew_grant_portal"
                                    string="Grant Portal Access" class="btn-secondary"
                                    invisible="not is_crew or user_id"/>
                        </group>
                    </group>
                    <group string="Crew Portal — hidden sections" invisible="not is_crew"
                           col="4">
                        <field name="crew_portal_hide_sales"/>
                        <field name="crew_portal_hide_invoices"/>
                        <field name="crew_portal_hide_purchases"/>
                        <field name="crew_portal_hide_projects"/>
                        <field name="crew_portal_hide_tasks"/>
                        <field name="crew_portal_hide_timesheets"/>
                        <field name="crew_portal_hide_subscriptions"/>
                        <field name="crew_portal_hide_signatures"/>
                    </group>
                    <div class="text-muted" invisible="crew_availability_mode != 'explicit'">
                        Explicit Availability: this crew member is considered
                        <b>unavailable</b> unless availability has been registered. A broad
                        24/7 calendar plus crew-managed leaves keep standard Odoo resource
                        availability authoritative for staffing.
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
