<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_form_crew" model="ir.ui.view">
        <field name="name">project.project.form.crew</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_crew_availability_request" type="object"
                        string="Request Availability" groups="hr.group_hr_user,planning.group_planning_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_crew_requests" type="object"
                        class="oe_stat_button" icon="calendar_today"
                        groups="hr.group_hr_user,planning.group_planning_user"
                        invisible="crew_request_count == 0">
                    <field name="crew_request_count" widget="statinfo" string="Availability"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="task_form_crew" model="ir.ui.view">
        <field name="name">project.task.form.crew</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_crew_schedule_shift" type="object"
                        string="Schedule Shift" groups="hr.group_hr_user,planning.group_planning_user"/>
                <button name="action_crew_availability_request" type="object"
                        string="Request Availability" groups="hr.group_hr_user,planning.group_planning_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_planning_slots" type="object"
                        class="oe_stat_button" icon="group"
                        groups="hr.group_hr_user,planning.group_planning_user"
                        invisible="planning_slot_count == 0">
                    <field name="planning_slot_count" widget="statinfo" string="Shifts"/>
                </button>
                <button name="action_view_crew_requests" type="object"
                        class="oe_stat_button" icon="calendar_today"
                        groups="hr.group_hr_user,planning.group_planning_user"
                        invisible="crew_request_count == 0">
                    <field name="crew_request_count" widget="statinfo" string="Availability"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
