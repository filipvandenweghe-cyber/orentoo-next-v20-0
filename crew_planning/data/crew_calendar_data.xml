<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Broad 24/7 calendar: attendance covers the whole week so that, for
             Explicit-Availability crew, "available" = anywhere not carved out by
             a (crew-managed) leave. tz=UTC keeps the day boundaries absolute. -->
        <record id="resource_calendar_crew" model="resource.calendar">
            <field name="name">Crew (24/7)</field>
            <field name="hours_per_day">24.0</field>
            <field name="attendance_ids" eval="[
                (0,0,{'dayofweek':'0','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'0','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'1','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'1','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'2','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'2','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'3','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'3','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'4','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'4','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'5','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'5','hour_from':12.0,'hour_to':24.0}),
                (0,0,{'dayofweek':'6','hour_from':0.0,'hour_to':12.0}),
                (0,0,{'dayofweek':'6','hour_from':12.0,'hour_to':24.0}),
            ]"/>
        </record>
    </data>
</odoo>
