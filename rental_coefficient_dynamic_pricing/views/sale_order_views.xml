<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Sale order form: add coefficient & dynamic pricing columns       -->
    <!-- to the order line list, visible only for rental orders.          -->
    <!-- ================================================================ -->
    <record id="sale_order_form_view_pricing_columns" model="ir.ui.view">
        <field name="name">sale.order.form.pricing.columns</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Visible pricing columns before price_unit.
                 Odoo 20 wraps price_unit in <column name="price_unit"> so modules can add
                 to the same cell; we want real columns, so anchor on the column itself.
                 Anchoring on the field would stack these inside the Base Price cell. -->
            <xpath expr="//field[@name='order_line']//list//column[@name='price_unit']"
                   position="before">
                <field name="base_rental_price"
                       string="Base Price"
                       column_invisible="not parent.is_rental_order"
                       optional="hide"
                       readonly="1"
                       help="Odoo-native rental price before coefficient and dynamic pricing adjustments."/>
                <field name="applied_coefficient"
                       string="Coeff."
                       column_invisible="not parent.is_rental_order"
                       optional="hide"
                       help="Charged-duration multiplier. Example: coefficient 5 for a 7-day rental means the customer pays for 5 units of the base price."/>
                <field name="applied_dynamic_factor_percentage"
                       string="Dyn. %"
                       column_invisible="not parent.is_rental_order"
                       optional="hide"
                       help="Dynamic pricing factor as a percentage. 100% = no change, 120% = +20% surcharge, 80% = -20% discount."/>
            </xpath>

            <!-- Hidden fields required for compute/onchange logic -->
            <xpath expr="//field[@name='order_line']//list//column[@name='price_unit']"
                   position="after">
                <field name="applied_coefficient_table_id" column_invisible="True"/>
                <field name="applied_coefficient_type_id" column_invisible="True"/>
                <field name="applied_dynamic_pricing_table_id" column_invisible="True"/>
                <field name="applied_dynamic_multiplier" column_invisible="True"/>
                <field name="manual_coefficient_override" column_invisible="True"/>
                <field name="manual_dynamic_factor_override" column_invisible="True"/>
                <field name="base_rental_price" column_invisible="True"/>
            </xpath>

        </field>
    </record>

</odoo>
