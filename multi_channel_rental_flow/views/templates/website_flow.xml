<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         Catalog page — product grid with categories
         ========================================================== -->

    <template id="website_catalog" name="Rental Flow Catalog">
        <t t-call="website.layout" additional_title.translate="Rental Flow">
            <div id="wrap" class="container mt-4 mb-5">

                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <h1 class="mb-0">Rental &amp; Activities</h1>
                        <a href="/rental-flow/basket"
                           class="btn btn-primary position-relative">
                            🛒 Basket
                            <t t-if="basket_count > 0">
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    <t t-esc="basket_count"/>
                                </span>
                            </t>
                        </a>
                    </div>
                </div>

                <!-- Categories -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/rental-flow"
                               t-attf-class="btn btn-sm #{not active_category and 'btn-primary' or 'btn-outline-secondary'}">
                                All
                            </a>
                            <t t-foreach="categories" t-as="cat">
                                <a t-attf-href="/rental-flow/category/#{cat.id}"
                                   t-attf-class="btn btn-sm #{active_category and active_category.id == cat.id and 'btn-primary' or 'btn-outline-secondary'}">
                                    <t t-esc="cat.name"/>
                                </a>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Product grid -->
                <div class="row g-3">
                    <t t-foreach="products" t-as="product">
                        <div class="col-6 col-md-4 col-lg-3">
                            <a t-attf-href="/rental-flow/product/#{product.id}"
                               class="text-decoration-none">
                                <div class="card h-100 shadow-sm border-0">
                                    <t t-if="product.image_512 and product.use_product_image_in_flow">
                                        <img t-attf-src="/rental-kiosk/image/#{product.id}"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover;"
                                             t-att-alt="product.name"/>
                                    </t>
                                    <t t-else="">
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                             style="height:200px;">
                                            <span class="text-muted" style="font-size:3rem;">📦</span>
                                        </div>
                                    </t>
                                    <div class="card-body">
                                        <span class="badge bg-secondary mb-1">
                                            <t t-esc="product.multi_channel_item_role"/>
                                        </span>
                                        <h6 class="card-title mb-1">
                                            <t t-esc="product.name"/>
                                        </h6>
                                        <p class="card-text text-success fw-bold mb-0">
                                            <t t-set="pp" t-value="product_prices.get(product.id, {})"/>
                                            <t t-if="pp.get('has_from')">from </t>
                                            <t t-esc="'%.2f' % pp.get('price', product.lst_price)"/>
                                            <t t-esc="currency_name"/>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                    <t t-if="not products">
                        <div class="col-12 text-center py-5 text-muted">
                            <p class="fs-4">No products available in this category.</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ==========================================================
         Product detail — datepicker, duration, qty, add to basket
         ========================================================== -->

    <template id="website_product_detail" name="Rental Flow Product Detail">
        <t t-call="website.layout" additional_title="product.name">
            <div id="wrap" class="container mt-4 mb-5">

                <!-- Back + basket -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a href="/rental-flow" class="btn btn-outline-secondary">← Back to catalog</a>
                    <a href="/rental-flow/basket" class="btn btn-primary">🛒 Basket</a>
                </div>

                <!-- Product header -->
                <div class="row mb-4">
                    <div class="col-md-5">
                        <t t-if="product.image_512 and product.use_product_image_in_flow">
                            <img t-attf-src="/rental-kiosk/image/#{product.id}"
                                 class="img-fluid rounded shadow"
                                 t-att-alt="product.name"/>
                        </t>
                    </div>
                    <div class="col-md-7">
                        <h2><t t-esc="product.name"/></h2>
                        <span class="badge bg-secondary mb-2">
                            <t t-esc="product.multi_channel_item_role"/>
                        </span>
                        <p class="text-muted" t-if="not product.requires_timeslot">
                            <span class="fs-4 text-success fw-bold">
                                <t t-esc="'%.2f' % product.lst_price"/>
                                <t t-esc="profile.pricelist_id.currency_id.name or profile.company_id.currency_id.name"/>
                            </span>
                        </p>
                    </div>
                </div>

                <!-- Interactive sections (JS-driven) -->
                <div id="rf-interactive"
                     t-att-data-product-id="product.id"
                     t-att-data-profile-id="profile.id"
                     t-att-data-item-role="product.multi_channel_item_role"
                     t-att-data-requires-timeslot="'1' if product.requires_timeslot else '0'"
                     t-att-data-requires-duration="'1' if product.requires_duration else '0'"
                     t-att-data-allow-qty="'1' if product.allow_quantity_selection else '0'"
                     t-att-data-list-price="product.lst_price"
                     t-att-data-currency="profile.pricelist_id.currency_id.name or profile.company_id.currency_id.name">

                    <!-- Quantity -->
                    <div class="card mb-3" id="rf-qty-section">
                        <div class="card-body">
                            <h5>Quantity</h5>
                            <div class="d-flex align-items-center gap-3">
                                <button class="btn btn-outline-secondary btn-lg" onclick="rfChangeQty(-1)">−</button>
                                <span class="fs-3 fw-bold" id="rf-qty-val">1</span>
                                <button class="btn btn-outline-secondary btn-lg" onclick="rfChangeQty(1)">+</button>
                            </div>
                        </div>
                    </div>

                    <!-- Events (shown first for event_ticket products) -->
                    <div class="card mb-3 d-none" id="rf-event-section">
                        <div class="card-body">
                            <h5>Select Event</h5>
                            <div id="rf-event-list"></div>
                        </div>
                    </div>

                    <!-- Duration (rental products) -->
                    <div class="card mb-3 d-none" id="rf-dur-section">
                        <div class="card-body">
                            <h5>Duration</h5>
                            <div class="d-flex gap-2 flex-wrap" id="rf-dur-list"></div>
                        </div>
                    </div>

                    <!-- Calendar -->
                    <div class="card mb-3 d-none" id="rf-cal-section">
                        <div class="card-body">
                            <h5>Select Date</h5>
                            <div class="text-center text-success fw-bold mb-2" id="rf-selected-date"></div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <button class="btn btn-sm btn-outline-secondary" onclick="rfCalNav(-1)">◀</button>
                                <span class="fw-bold" id="rf-cal-month"></span>
                                <button class="btn btn-sm btn-outline-secondary" onclick="rfCalNav(1)">▶</button>
                            </div>
                            <div class="rf-calendar" id="rf-cal-grid"></div>
                        </div>
                    </div>

                    <!-- Timeslots -->
                    <div class="card mb-3 d-none" id="rf-slot-section">
                        <div class="card-body">
                            <h5>Select Pick-Up Moment — <span class="text-success" id="rf-slot-date"></span></h5>
                            <div class="rf-slots" id="rf-slot-grid"></div>
                        </div>
                    </div>

                    <!-- Availability warning -->
                    <div class="alert alert-danger d-none mb-3" id="rf-avail-warning" role="alert">
                        <strong>Not enough availability.</strong>
                        <span id="rf-avail-warning-text"></span>
                    </div>

                    <!-- Add to basket -->
                    <div class="card mb-3 d-none" id="rf-add-section">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-success mb-3" id="rf-add-price"></div>
                            <button class="btn btn-success btn-lg w-100" onclick="rfAddToBasket()">
                                Add to Basket
                            </button>
                        </div>
                    </div>

                    <div class="text-center text-muted" id="rf-msg"></div>
                </div>
            </div>

            <style>
                .rf-calendar { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
                .rf-cal-day { padding:12px 6px; border-radius:8px; text-align:center; cursor:pointer; font-size:1rem; border:3px solid transparent; min-height:48px; display:flex; align-items:center; justify-content:center; }
                .rf-cal-day:hover { opacity:0.85; }
                .rf-cal-day.selected { border-color:#000 !important; }
                .rf-cal-day-hdr { text-align:center; font-size:0.8rem; color:#666; padding:4px 0; font-weight:600; }
                .rf-slots { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:8px; max-height:300px; overflow-y:auto; }
                .rf-slot { padding:10px; border-radius:8px; text-align:center; cursor:pointer; border:3px solid transparent; color:#fff; font-size:0.9rem; }
                .rf-slot:hover { opacity:0.85; }
                .rf-slot.selected { border-color:#000 !important; }
                .rf-slot.unavailable { opacity:0.4; cursor:not-allowed; }
            </style>

            <script type="text/javascript">
                var TRANSLATIONS = <t t-raw="translations_json"/>;
            </script>
            <script type="text/javascript"
                    src="/multi_channel_rental_flow/static/src/js/website_flow.js?v=9"/>
        </t>
    </template>

    <!-- ==========================================================
         Basket page
         ========================================================== -->

    <template id="website_basket" name="Rental Flow Basket">
        <t t-call="website.layout" additional_title.translate="Basket">
            <div id="wrap" class="container mt-4 mb-5">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Your Basket</h1>
                    <a href="/rental-flow" class="btn btn-outline-secondary">← Continue shopping</a>
                </div>

                <t t-if="items_data">
                    <div class="card mb-4">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Details</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Price</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="items_data" t-as="idata">
                                        <t t-set="item" t-value="idata['item']"/>
                                        <tr>
                                            <td>
                                                <strong><t t-esc="item.product_id.name"/></strong>
                                                <br/>
                                                <span class="badge bg-secondary">
                                                    <t t-esc="item.item_role"/>
                                                </span>
                                            </td>
                                            <td>
                                                <t t-if="item.slot_id">
                                                    <t t-esc="item.slot_id.name"/>
                                                </t>
                                                <t t-if="item.event_id">
                                                    <t t-esc="item.event_id.name"/>
                                                </t>
                                            </td>
                                            <td class="text-center align-middle">
                                                <div class="d-flex align-items-center justify-content-center gap-2">
                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            t-attf-onclick="rfUpdateQty(#{item.id}, #{item.quantity - 1})">−</button>
                                                    <span class="fw-bold"><t t-esc="int(item.quantity)"/></span>
                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            t-attf-onclick="rfUpdateQty(#{item.id}, #{item.quantity + 1})">+</button>
                                                </div>
                                            </td>
                                            <td class="text-end align-middle fw-bold">
                                                <t t-esc="'%.2f' % idata['total_incl']"/>
                                                <t t-esc="dossier.currency_id.name"/>
                                            </td>
                                            <td class="text-end align-middle">
                                                <button class="btn btn-sm btn-outline-danger"
                                                        t-attf-onclick="rfRemoveItem(#{item.id})">✕</button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Totals -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <span>Subtotal</span>
                                <span><t t-esc="'%.2f' % subtotal"/> <t t-esc="dossier.currency_id.name"/></span>
                            </div>
                            <div class="d-flex justify-content-between text-muted" t-if="tax_total > 0">
                                <span>Tax</span>
                                <span><t t-esc="'%.2f' % tax_total"/> <t t-esc="dossier.currency_id.name"/></span>
                            </div>
                            <hr/>
                            <div class="d-flex justify-content-between fs-4 fw-bold">
                                <span>Total</span>
                                <span class="text-success">
                                    <t t-esc="'%.2f' % total"/>
                                    <t t-esc="dossier.currency_id.name"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Checkout form -->
                    <div class="card">
                        <div class="card-body">
                            <h5>Your Details</h5>
                            <form action="/rental-flow/checkout" method="POST">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Name</label>
                                        <input type="text" name="name" class="form-control"
                                               placeholder="Your name (optional)"
                                               t-att-value="dossier.partner_id.name if not request.env.user._is_public() else ''"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email *</label>
                                        <input type="email" name="email" class="form-control" required="required"
                                               placeholder="your@email.com"
                                               t-att-value="dossier.partner_email or dossier.partner_id.email or ''"/>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success btn-lg w-100">
                                    Checkout &amp; Pay
                                </button>
                            </form>
                        </div>
                    </div>
                </t>

                <t t-if="not items_data">
                    <div class="text-center py-5 text-muted">
                        <p class="fs-4">Your basket is empty.</p>
                        <a href="/rental-flow" class="btn btn-primary">Browse products</a>
                    </div>
                </t>
            </div>

            <script type="text/javascript"
                    src="/multi_channel_rental_flow/static/src/js/website_flow.js?v=9"/>
        </t>
    </template>

    <!-- ==========================================================
         Confirmation page
         ========================================================== -->

    <template id="website_confirmation" name="Rental Flow Confirmation">
        <t t-call="website.layout" additional_title.translate="Booking Confirmed">
            <div id="wrap" class="container mt-4 mb-5 text-center">
                <div class="py-5">
                    <div style="font-size:4rem;">✅</div>
                    <h1 class="mt-3">Booking Confirmed!</h1>
                    <p class="fs-5 text-muted">
                        Your booking <strong><t t-esc="dossier.display_name"/></strong>
                        has been confirmed and paid.
                    </p>
                    <p>
                        A confirmation email has been sent to
                        <strong><t t-esc="dossier.partner_email or dossier.partner_id.email"/></strong>.
                    </p>
                    <div class="card mx-auto mt-4" style="max-width:500px;">
                        <div class="card-body">
                            <h5>Retrieve your tickets at the kiosk</h5>
                            <p>Enter your dossier number and email:</p>
                            <p class="fs-5 fw-bold"><t t-esc="dossier.name"/></p>
                            <p class="text-muted">
                                <t t-esc="dossier.partner_email or dossier.partner_id.email"/>
                            </p>
                        </div>
                    </div>
                    <a href="/rental-flow" class="btn btn-primary mt-4">
                        Continue Browsing
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ==========================================================
         Checkout error page
         ========================================================== -->

    <template id="website_checkout_error" name="Rental Flow Checkout Error">
        <t t-call="website.layout" additional_title.translate="Checkout Error">
            <div id="wrap" class="container mt-4 mb-5 text-center">
                <div class="py-5">
                    <div style="font-size:4rem;">❌</div>
                    <h1 class="mt-3">Something went wrong</h1>
                    <p class="text-danger fs-5"><t t-esc="error"/></p>
                    <a href="/rental-flow/basket" class="btn btn-outline-secondary mt-3">
                        ← Back to Basket
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
