<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_rental_purchase" model="ir.ui.view">
        <field name="name">purchase.order.form.rental.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button: rental returns -->
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_view_rental_returns"
                        class="oe_stat_button"
                        icon="refresh"
                        invisible="not is_rental_purchase or rental_return_picking_count == 0">
                    <field name="rental_return_picking_count" widget="statinfo"
                           string="Rental Returns"/>
                </button>
            </div>

            <!-- Rental Purchase flag + dates, near the order scheduling info -->
            <field name="date_order" position="after">
                <field name="is_rental_purchase"/>
                <field name="rental_start_date"
                       invisible="not is_rental_purchase"
                       required="is_rental_purchase"/>
                <field name="rental_return_date"
                       invisible="not is_rental_purchase"
                       required="is_rental_purchase"/>
            </field>

        </field>
    </record>

</odoo>
