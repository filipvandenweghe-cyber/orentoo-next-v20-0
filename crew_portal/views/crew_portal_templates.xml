<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- No crew profile -->
    <template id="portal_not_crew" name="Crew: no profile">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <p class="text-muted mt-3">No crew profile is linked to your account.
                    Please contact the planner.</p>
            </div>
        </t>
    </template>

    <!-- My Availability -->
    <template id="portal_my_availability" name="My Availability">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <h3 class="mt-3">My Availability</h3>

                <t t-if="inv_rows">
                    <h5 class="mt-4">Open availability requests</h5>
                    <t t-foreach="inv_rows" t-as="inv">
                        <div class="card mb-2"><div class="card-body">
                            <h5 class="card-title mb-1" t-out="inv['header']"/>
                            <div class="text-muted small">Posted at <t t-out="inv['posted']"/></div>
                            <div t-if="inv['period']" class="mt-1">Requested availability
                                <t t-out="inv['period']"/></div>
                            <div t-if="inv['indicative_hours']" class="text-muted">
                                Indicative effort: ~<t t-out="inv['indicative_hours']"/> h
                            </div>
                            <div class="alert alert-warning mt-2 mb-2 py-1">
                                This is only a request for availability — you have not been
                                scheduled yet.
                            </div>
                            <form t-attf-action="/my/invitation/{{inv['id']}}/respond" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" name="response" value="available"
                                        class="btn btn-success btn-sm">I'm available</button>
                                <button type="submit" name="response" value="unavailable"
                                        class="btn btn-secondary btn-sm">Not available</button>
                            </form>
                            <div class="small text-muted mt-2">Planning ID:
                                <t t-out="inv['planning_id']"/></div>
                        </div></div>
                    </t>
                </t>

                <h5 class="mt-4">Register availability</h5>
                <form action="/my/availability/register" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-12 col-md-auto">
                        <label class="form-label mb-1" for="reg_from">From</label>
                        <input type="datetime-local" id="reg_from" name="date_start"
                               class="form-control" t-att-value="default_start" required="required"/>
                    </div>
                    <div class="col-12 col-md-auto">
                        <label class="form-label mb-1" for="reg_to">To</label>
                        <input type="datetime-local" id="reg_to" name="date_end"
                               class="form-control" t-att-value="default_end" required="required"/>
                    </div>
                    <div class="col-12 col-md-auto">
                        <label class="form-label mb-1" for="reg_state">Status</label>
                        <select id="reg_state" name="state" class="form-select">
                            <option value="available">Available</option>
                            <option value="unavailable">Unavailable</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-auto">
                        <button type="submit" class="btn btn-primary w-100">Save</button>
                    </div>
                </form>

                <h5 class="mt-4">My availability</h5>
                <table class="table table-sm">
                    <thead><tr><th>From</th><th>To</th><th>Last updated</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                        <t t-foreach="win_rows" t-as="w">
                            <tr>
                                <td t-out="w['start']"/>
                                <td t-out="w['end']"/>
                                <td class="text-muted small" t-out="w['updated']"/>
                                <td class="text-end">
                                    <form t-attf-action="/my/availability/window/{{w['id']}}/remove"
                                          method="post" class="m-0">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <button type="submit"
                                                class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="not win_rows">
                            <td colspan="4" class="text-muted">No availability registered yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- My Planning -->
    <template id="portal_my_planning" name="My Planning">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <h3 class="mt-3">My Planning</h3>
                <p t-if="not slot_rows" class="text-muted">No upcoming shifts.</p>
                <t t-foreach="slot_rows" t-as="slot">
                    <div class="card mb-2"><div class="card-body">
                        <div>
                            <strong><t t-out="slot['start']"/> → <t t-out="slot['end']"/></strong>
                        </div>
                        <div t-if="slot['project']">Project: <t t-out="slot['project']"/></div>
                        <div t-if="slot['task']">Task: <t t-out="slot['task']"/></div>
                        <div t-if="slot['role']">Role: <t t-out="slot['role']"/></div>
                        <div t-if="slot['reported']"
                             class="alert alert-warning mt-2 mb-0 py-1">
                            You reported you can no longer work this shift. The planner
                            has been notified.
                        </div>
                        <form t-else="" t-attf-action="/my/planning/{{slot['id']}}/cannot-work"
                              method="post" class="mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" name="reason" placeholder="Reason (optional)"
                                   class="form-control form-control-sm mb-1"/>
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                I can no longer work this shift
                            </button>
                        </form>
                    </div></div>
                </t>
            </div>
        </t>
    </template>

    <!-- My Hours -->
    <template id="portal_my_hours" name="My Hours">
        <t t-call="portal.portal_layout">
            <div class="container o_portal">
                <h3 class="mt-3">My Hours</h3>

                <h5 class="mt-4">Shifts to declare</h5>
                <p t-if="not todo_rows" class="text-muted">Nothing to declare right now.</p>
                <t t-foreach="todo_rows" t-as="s">
                    <div class="card mb-2"><div class="card-body">
                        <!-- Portrait / narrow screens: stacked lines -->
                        <div class="mb-2 d-md-none">
                            <div><strong><t t-out="s['start']"/> →</strong></div>
                            <div><strong><t t-out="s['end']"/></strong></div>
                            <div t-if="s['project'] or s['task']" class="text-muted">
                                <t t-out="s['project']"/>
                                <t t-if="s['project'] and s['task']"> · </t>
                                <t t-out="s['task']"/>
                            </div>
                        </div>
                        <!-- Landscape / tablet and up: single line (unchanged) -->
                        <div class="mb-2 d-none d-md-block">
                            <strong><t t-out="s['start']"/> → <t t-out="s['end']"/></strong>
                            <span t-if="s['project']" class="text-muted"> ·
                                <t t-out="s['project']"/></span>
                            <span t-if="s['task']" class="text-muted"> ·
                                <t t-out="s['task']"/></span>
                        </div>
                        <form t-attf-action="/my/hours/{{s['id']}}/declare" method="post"
                              class="row g-2 align-items-end">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Started</label>
                                <input type="datetime-local" name="actual_start"
                                       class="form-control form-control-sm"
                                       t-att-value="s['default_start']" required="required"/>
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Ended</label>
                                <input type="datetime-local" name="actual_end"
                                       class="form-control form-control-sm"
                                       t-att-value="s['default_end']" required="required"/>
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Break (min)</label>
                                <input type="number" name="break_minutes" min="0" step="5"
                                       class="form-control form-control-sm"
                                       t-att-value="s['break_minutes']"/>
                            </div>
                            <div class="col-12 col-md">
                                <label class="form-label small mb-0">Comment</label>
                                <input type="text" name="comment"
                                       class="form-control form-control-sm"
                                       t-att-value="s['comment']"/>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    Submit
                                </button>
                            </div>
                        </form>
                    </div></div>
                </t>

                <t t-if="done_rows">
                    <h5 class="mt-4">Submitted / approved</h5>
                    <table class="table table-sm">
                        <thead><tr>
                            <th>From</th><th>To</th><th>Project</th>
                            <th class="text-end">Hours</th><th>Status</th>
                        </tr></thead>
                        <tbody>
                            <t t-foreach="done_rows" t-as="d">
                                <tr>
                                    <td t-out="d['start']"/>
                                    <td t-out="d['end']"/>
                                    <td t-out="d['project']"/>
                                    <td class="text-end" t-out="d['worked_hours']"/>
                                    <td t-out="d['state']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

</odoo>
